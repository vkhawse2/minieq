<?xml version="1.0" encoding="UTF-8"?>
<!--
  MiniEQ.wxs: WiX v3 installer source for MiniEQ.

  Installs (per-machine, Program Files):
    MiniEQ.exe        the tiny Win32 UI
    MiniEQ_APO.dll    the system-effect APO, COM self-registered on
                      install (DllRegisterServer) and unregistered on
                      uninstall (DllUnregisterServer)

  Per-endpoint attach (FxProperties) IS done by the installer now: a
  best-effort deferred custom action (CA_AttachAll, runs as SYSTEM)
  attaches MiniEQ to every render endpoint present at install time, so a
  fresh machine just works. Devices plugged in later are still attached
  from the app's "Attach" button, and uninstall detaches every endpoint
  (CA_DetachAll) so no SFX slot is left pointing at a deleted DLL.

  Build (from repo root, WiX v3 on PATH):
    candle -arch x64 -dBinDir=build\Release installer\MiniEQ.wxs -out build\MiniEQ.wixobj
    light  build\MiniEQ.wixobj -out build\MiniEQ-0.1.0-x64.msi
-->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*"
           Name="MiniEQ"
           Language="1033"
           Version="0.2.6"
           Manufacturer="vkhawse2"
           UpgradeCode="A220824C-9C18-477E-92BB-1E0210B316DB">

    <Package InstallerVersion="500"
             Compressed="yes"
             InstallScope="perMachine"
             Description="MiniEQ -- minimal system-wide equalizer for Windows"
             Comments="Standalone sAPO + native Win32 UI. No Equalizer APO required." />

    <MajorUpgrade DowngradeErrorMessage="A newer version of MiniEQ is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLFOLDER" Name="MiniEQ" />
      </Directory>
      <Directory Id="ProgramMenuFolder">
        <Directory Id="ApplicationProgramsFolder" Name="MiniEQ" />
      </Directory>
      <!--
        Machine-wide settings mirror (C:\ProgramData\MiniEQ\devices.ini):
        the audio engine cannot reach the interactive user's %APPDATA%, so
        the APO cold-starts from this mirror when the UI isn't running. The
        installer creates it with Users write access because a standard
        (non-elevated) UI cannot create folders directly under ProgramData.
      -->
      <Directory Id="CommonAppDataFolder">
        <Directory Id="CommonAppDataMiniEQ" Name="MiniEQ" />
      </Directory>
    </Directory>

    <Feature Id="ProductFeature" Title="MiniEQ" Level="1" Description="MiniEQ app and audio engine plug-in.">
      <ComponentRef Id="Comp_MiniEQ_exe" />
      <ComponentRef Id="Comp_MiniEQ_APO_dll" />
      <ComponentRef Id="Comp_StartMenuShortcut" />
      <ComponentRef Id="Comp_CommonAppDataDir" />
    </Feature>

    <Component Id="Comp_MiniEQ_exe"
               Guid="5920F25B-69E7-4B33-B31A-6C7898F253A9"
               Directory="INSTALLFOLDER">
      <File Id="File_MiniEQ_exe"
            Source="$(var.BinDir)\MiniEQ.exe"
            KeyPath="yes" />
    </Component>

    <!--
      Start Menu shortcut lives in its own component (the documented WiX
      pattern for per-machine packages): a non-advertised shortcut must use
      a registry KeyPath (ICE43/ICE57), and RemoveFolder cleans up the
      Programs\MiniEQ folder on uninstall (ICE64).
    -->
    <Component Id="Comp_StartMenuShortcut"
               Guid="17004A20-1A0C-47DF-968C-B22517BC63FD"
               Directory="ApplicationProgramsFolder">
      <Shortcut Id="Shortcut_StartMenu"
                Name="MiniEQ"
                Description="MiniEQ -- minimal system-wide equalizer"
                Target="[INSTALLFOLDER]MiniEQ.exe"
                WorkingDirectory="INSTALLFOLDER" />
      <RemoveFolder Id="Remove_ApplicationProgramsFolder" On="uninstall" />
      <RegistryValue Root="HKCU"
                     Key="Software\MiniEQ"
                     Name="installed"
                     Type="integer"
                     Value="1"
                     KeyPath="yes" />
    </Component>

    <Component Id="Comp_MiniEQ_APO_dll"
               Guid="148E2613-A394-44A6-BC49-FCC4EFD26B28"
               Directory="INSTALLFOLDER">
      <!--
        SelfRegCost="1": Windows Installer calls the DLL's DllRegisterServer
        at install time (registers COM CLSID {5E52BF50-F229-46A0-8B7D-AA805D47FB60})
        and DllUnregisterServer at uninstall. Runs elevated: the package is
        per-machine.
      -->
      <File Id="File_MiniEQ_APO_dll"
            Source="$(var.BinDir)\MiniEQ_APO.dll"
            KeyPath="yes"
            SelfRegCost="1" />
    </Component>

    <!--
      Machine-wide settings mirror directory. KeyPath is the folder itself
      (CreateFolder); the Permission element grants Users full control so
      the non-elevated UI can write devices.ini and the audio engine can
      read it. Removed on uninstall only if empty (RemoveFolder On="uninstall"
      is deliberately omitted; another version's mirror may be in use).
    -->
    <Component Id="Comp_CommonAppDataDir"
               Guid="248BDB29-5FF8-4919-8F86-AF721EFFB1D7"
               Directory="CommonAppDataMiniEQ"
               KeyPath="yes">
      <CreateFolder>
        <Permission User="Users" GenericAll="yes" />
      </CreateFolder>
    </Component>

    <!--
      Per-endpoint registry as part of installation. Both actions run
      deferred as SYSTEM (Impersonate="no") and are best-effort
      (Return="ignore"): MiniEQ.exe's attach-all / detach-all switches are
      fully silent and always exit 0, so one stubborn device can never fail
      or roll back the setup.
    -->
    <CustomAction Id="CA_AttachAll"
                  FileKey="File_MiniEQ_exe"
                  ExeCommand="--attach-all"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />
    <CustomAction Id="CA_DetachAll"
                  FileKey="File_MiniEQ_exe"
                  ExeCommand="--detach-all"
                  Execute="deferred"
                  Impersonate="no"
                  Return="ignore" />

    <InstallExecuteSequence>
      <!-- After the files land, attach every endpoint present right now. -->
      <Custom Action="CA_AttachAll" After="InstallFiles">NOT Installed</Custom>
      <!-- On uninstall (not on upgrade), detach every endpoint so no SFX
           slot dangles at a deleted DLL. The exe still exists here because
           this runs before RemoveFiles. -->
      <Custom Action="CA_DetachAll" Before="RemoveFiles">Installed AND REMOVE="ALL" AND NOT UPGRADINGPRODUCTCODE</Custom>
    </InstallExecuteSequence>

  </Product>
</Wix>
